{
  "name": "hmail-control-center",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "contracts:generate": "bun tools/web/generate-contracts.ts",
    "contracts:check": "bun apps/web/node_modules/typescript/bin/tsc --project tools/web/tsconfig.json && bun tools/web/check-contracts.ts",
    "web:check": "bun run --cwd apps/web check",
    "web:build": "bun run --cwd apps/web build"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "@types/bun": "1.4.3",
    "@types/json-schema": "7.0.15"
  }
}
