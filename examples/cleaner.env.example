# Copy to a PRIVATE file; do not commit real credentials.
# Percent-encode reserved characters in username/password.
DATABASE_URL='mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE'
HMAIL_DATA_DIR='D:\hmailserver\data'
HMAIL_INI='D:\hmailserver\Bin\hMailServer.ini'
# Keep messages newer than one calendar month. Alternative: HMAIL_BEFORE.
HMAIL_OLDER_THAN=1mo
HMAIL_SERVICE_NAME=hMailServer
HMAIL_BATCH_SIZE=1000
HMAIL_WORKERS=2
HMAIL_SCAN=fast
# Optional for direct runs; required for silent and service runs.
HMAIL_LOG_FILE='C:\private\hmail-cleaner.ndjson'
# Required by service run: local daily time, HH:MM; no immediate startup cleanup.
HMAIL_RUN_AT=02:30
