# Скопируйте в cleaner.env рядом с hmail-cleaner.exe.
# Замените пароль; специальные символы в DATABASE_URL должны быть URL-encoded.
DATABASE_URL=mysql://rust:CHANGE_ME@127.0.0.1/hmailserver
HMAIL_DATA_DIR='D:\hmailserver\data'
HMAIL_INI='D:\hmailserver\Bin\hMailServer.ini'
HMAIL_OLDER_THAN=2y
# Вместо периода можно использовать точную местную границу (один параметр):
# HMAIL_BEFORE=2024-09-15T23:00:00
HMAIL_SCAN=fast
HMAIL_SERVICE_NAME=hMailServer
HMAIL_BATCH_SIZE=1000
HMAIL_WORKERS=2
# Журнал необязателен. Для --silence и службы требуется абсолютный путь:
# HMAIL_LOG_FILE='C:\bin\cleaner.log'
# Для службы также задайте местное время запуска:
# HMAIL_RUN_AT=02:30
