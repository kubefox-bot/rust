{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Astra signed delivery descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "product",
    "channel",
    "source_sha",
    "build",
    "sequence",
    "image",
    "release_manifest_sha256",
    "updater_min",
    "updater_max",
    "schema_version",
    "protocol_min",
    "protocol_max"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "product": {
      "const": "astra-center"
    },
    "channel": {
      "const": "main"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "build": {
      "type": "string",
      "pattern": "^git-[0-9a-f]{40}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest", "config_digest", "platform"],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^ghcr\\.io/kubefox-bot/astra-center@sha256:[0-9a-f]{64}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "config_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "const": "linux/amd64"
        }
      }
    },
    "release_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "updater_min": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "updater_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "schema_version": {
      "const": 1
    },
    "protocol_min": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "protocol_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
