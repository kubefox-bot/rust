---
import "../styles/global.css";
import { publicBuild } from "../config/build";
interface Props {
  title: string;
  section?: "cleanup" | "history" | "settings" | "login";
}
const { title, section = "cleanup" } = Astro.props;
const build = publicBuild();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>{title} · Mail Control</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar" aria-label="Главная навигация">
        <a class="brand" href="/">
          <span class="brand-mark">
            <svg
              width="19"
              height="19"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <rect
                x="3"
                y="5"
                width="18"
                height="14"
                rx="3"
                stroke="currentColor"
                stroke-width="1.6"
              />
              <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.6" />
            </svg>
          </span>
          Mail Control
        </a>
        <nav>
          <div class="nav-label">РАБОЧАЯ ОБЛАСТЬ</div>
          <a
            href="/"
            class="nav-item active"
            aria-current={section === "cleanup" ? "page" : undefined}
          >
            <svg
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v5m4-5v5"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
            </svg>
            Очистка почты
          </a>
        </nav>
        <div class="sidebar-note">
          Центр управления
          <br />
          hMailServer
        </div>
      </aside>
      <div class="workspace">
        <header class="topbar">
          <div>
            <div class="topbar-title">Управление серверами</div>
            <div class="topbar-context">hMailServer / {title}</div>
          </div>
          <nav class="header-actions" aria-label="Сервер и учётная запись">
            <a
              href="/history/"
              data-history-link
              aria-current={section === "history" ? "page" : undefined}
            >
              История
            </a>
            <span class="header-separator"></span>
            <a
              href="/settings/"
              data-settings-link
              aria-current={section === "settings" ? "page" : undefined}
            >
              Настройки
            </a>
            <a class="account-link" href="/login/" data-account-link>
              <span class="avatar" aria-hidden="true">
                ··
              </span>
              <span data-account-label>Вход</span>
            </a>
            <button class="link" type="button" data-logout hidden>
              Выйти
            </button>
          </nav>
        </header>
        <main class="main">
          <slot />
        </main>
        <footer class="footer">
          <span>
            Mail Control <span class="build">· {build.version}</span>
          </span>
          <span data-agents-footer>
            Агенты · состояние доступно после входа
          </span>
        </footer>
      </div>
    </div>
  </body>
</html>
